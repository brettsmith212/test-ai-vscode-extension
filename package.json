{
  "name": "test-extension",
  "displayName": "Claude Chat",
  "description": "A VS Code extension for chatting with Claude-3.5",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.54.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claude-chat.openChat",
        "title": "Open Claude Chat"
      },
      {
        "command": "amp-scm.reviewWithAmp",
        "title": "Review with Amp",
        "icon": "$(sparkle)"
      },
      {
        "command": "amp-scm.refreshAnalysis",
        "title": "Refresh Analysis",
        "icon": "$(refresh)"
      },
      {
        "command": "amp-scm.openDiff",
        "title": "Open Diff"
      },
      {
        "command": "amp-scm.markAsReviewed",
        "title": "Mark as Reviewed"
      },
      {
        "command": "amp-scm.refreshTree",
        "title": "Refresh Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "amp-scm.showTreeStats",
        "title": "Show Statistics",
        "icon": "$(graph)"
      },
      {
        "command": "amp-scm.collapseAllGroups",
        "title": "Collapse All Groups",
        "icon": "$(collapse-all)"
      },
      {
        "command": "amp-scm.expandAllGroups",
        "title": "Expand All Groups",
        "icon": "$(expand-all)"
      },
      {
        "command": "amp-scm.openFile",
        "title": "Open File"
      },
      {
        "command": "amp-scm.openFileDiff",
        "title": "Open Diff",
        "icon": "$(diff)"
      },
      {
        "command": "amp-scm.markFileAsReviewed",
        "title": "Mark as Reviewed",
        "icon": "$(check)"
      },
      {
        "command": "amp-scm.showFileDetails",
        "title": "Show Details",
        "icon": "$(info)"
      },
      {
        "command": "amp-scm.copyFilePath",
        "title": "Copy Path",
        "icon": "$(copy)"
      },
      {
        "command": "amp-scm.openAllFilesInGroup",
        "title": "Open All Files"
      },
      {
        "command": "amp-scm.markGroupAsReviewed",
        "title": "Mark Group as Reviewed"
      },
      {
        "command": "amp-scm.changeGrouping",
        "title": "Change Grouping"
      },
      {
        "command": "amp-scm.toggleFileCount",
        "title": "Toggle File Count"
      },
      {
        "command": "amp-scm.showEnhancedFileDetails",
        "title": "Show Enhanced Details",
        "icon": "$(info)"
      },
      {
        "command": "amp-scm.openFileWithAnalysis",
        "title": "Open with Analysis",
        "icon": "$(graph)"
      },
      {
        "command": "amp-scm.showAnalysisPicker",
        "title": "Show Analysis Picker",
        "icon": "$(list-selection)"
      },
      {
        "command": "amp-scm.generateAnalysisReport",
        "title": "Generate Analysis Report",
        "icon": "$(file-text)"
      },
      {
        "command": "amp-scm.showWelcome",
        "title": "Show Welcome Message",
        "icon": "$(info)"
      },
      {
        "command": "amp-scm.showDemoInfo",
        "title": "Show Demo Information",
        "icon": "$(question)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "amp-scm.reviewWithAmp",
          "group": "navigation@1",
          "when": "scmProvider == git"
        },
        {
          "command": "amp-scm.showAnalysisPicker",
          "group": "navigation@2",
          "when": "scmProvider == git"
        },
        {
          "command": "amp-scm.generateAnalysisReport",
          "group": "navigation@3",
          "when": "scmProvider == git"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "amp-scm.refreshAnalysis",
          "group": "inline",
          "when": "scmProvider == git"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "amp-scm.showEnhancedFileDetails",
          "when": "scmProvider == git",
          "group": "1_analysis@1"
        },
        {
          "command": "amp-scm.openFileWithAnalysis",
          "when": "scmProvider == git",
          "group": "1_analysis@2"
        }
      ],
      "view/title": [
        {
          "command": "amp-scm.refreshTree",
          "when": "view == ampReview",
          "group": "navigation@1"
        },
        {
          "command": "amp-scm.showTreeStats",
          "when": "view == ampReview",
          "group": "navigation@2"
        },
        {
          "command": "amp-scm.changeGrouping",
          "when": "view == ampReview",
          "group": "navigation@3"
        },
        {
          "command": "amp-scm.collapseAllGroups",
          "when": "view == ampReview",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "amp-scm.openFile",
          "when": "view == ampReview && viewItem == amp-review-file",
          "group": "navigation@1"
        },
        {
          "command": "amp-scm.openFileDiff",
          "when": "view == ampReview && viewItem == amp-review-file",
          "group": "navigation@2"
        },
        {
          "command": "amp-scm.showFileDetails",
          "when": "view == ampReview && viewItem == amp-review-file",
          "group": "navigation@3"
        },
        {
          "command": "amp-scm.markFileAsReviewed",
          "when": "view == ampReview && viewItem == amp-review-file",
          "group": "actions@1"
        },
        {
          "command": "amp-scm.copyFilePath",
          "when": "view == ampReview && viewItem == amp-review-file",
          "group": "actions@2"
        },
        {
          "command": "amp-scm.openAllFilesInGroup",
          "when": "view == ampReview && viewItem == amp-review-group",
          "group": "navigation@1"
        },
        {
          "command": "amp-scm.markGroupAsReviewed",
          "when": "view == ampReview && viewItem == amp-review-group",
          "group": "actions@1"
        }
      ]
    },
    "views": {
      "scm": [
        {
          "id": "ampReview",
          "name": "Amp Review",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "Claude Chat",
      "properties": {
        "claudeChat.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for Claude-3.5"
        },
        "ampScm.enableDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Enable file decorations for Amp analysis"
        },
        "ampScm.showRiskIndicators": {
          "type": "boolean",
          "default": true,
          "description": "Show risk level indicators in source control"
        },
        "ampScm.treeView.groupBy": {
          "type": "string",
          "enum": ["risk", "category", "fileType"],
          "default": "risk",
          "description": "How to group files in the Amp Review tree"
        },
        "ampScm.treeView.showFileCount": {
          "type": "boolean",
          "default": true,
          "description": "Show file count in tree group labels"
        },
        "ampScm.treeView.expandGroups": {
          "type": "boolean",
          "default": true,
          "description": "Expand tree groups by default"
        },
        "ampScm.treeView.sortOrder": {
          "type": "string",
          "enum": ["alphabetical", "priority", "riskLevel"],
          "default": "priority",
          "description": "Sort order for tree groups"
        },
        "ampScm.hasShownWelcome": {
          "type": "boolean",
          "default": false,
          "description": "Whether the welcome message has been shown"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:webviews",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src webviews",
    "test": "vscode-test",
    "build:webviews": "vite build",
    "watch:webviews": "vite",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/blocks": "^8.6.12",
    "@storybook/builder-vite": "^8.6.12",
    "@storybook/react": "^8.6.12",
    "@storybook/react-vite": "^8.6.12",
    "@storybook/testing-library": "^0.2.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/vscode": "^1.54.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.23.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.2",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-toast": "^1.2.7",
    "axios": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.10.0",
    "lucide-react": "^0.487.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-markdown": "^10.0.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7"
  }
}
